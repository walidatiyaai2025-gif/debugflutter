<Window x:Class="FlutterBuildDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flutter Build Doctor"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Flutter Build Doctor" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="4,8,4,26" />
                    <TextBlock Text="HOME" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,0,0,8" />
                    <Button Content="Dashboard" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Projects" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <TextBlock Text="TOOLCHAIN" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,18,0,8" />
                    <Button Content="Environment Doctor" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Compatibility" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Build Center" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Devices &amp; Emulators" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <TextBlock Text="RECOVERY" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,18,0,8" />
                    <Button Content="Problems" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Auto Repair" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Release Center" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid ToolTip="{Binding ProjectHeader.RepositoryPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,4,18,4">
                    <TextBlock Text="{Binding ProjectHeader.ProjectName}" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ProjectHeader.BranchText}" Foreground="#CBD5E1" FontSize="11" />
                        <TextBlock Text="  •  " Foreground="#475569" FontSize="11" />
                        <TextBlock Text="{Binding ProjectHeader.CommitText}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProjectHeader.RemoteText}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Import Project"
                        Command="{Binding RepositoryManager.ImportCommand}"
                        Padding="18,9"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <TextBlock Text="System readiness" Foreground="#F8FAFC" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Import the repository first, then validate Git, Flutter, Java and Android before the first build." Foreground="#94A3B8" FontSize="14" Margin="0,6,0,24" />

                <Border Padding="22" Margin="0,0,0,22" Background="#111C2F" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Repository Manager" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Clone a new repository or safely refresh an existing Git folder, then switch to the requested branch." Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding RepositoryManager.GitStatus}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Git URL" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding RepositoryManager.RepositoryUrl, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding RepositoryManager.CanEdit}"
                                     Padding="10,8" Margin="0,0,0,12"
                                     Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Branch" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,12" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding RepositoryManager.Branch, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding RepositoryManager.CanEdit}"
                                     Padding="10,8" Margin="0,0,0,12"
                                     Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding RepositoryManager.WorkspaceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding RepositoryManager.CanEdit}"
                                     Padding="10,8"
                                     Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Import / Refresh"
                                    Command="{Binding RepositoryManager.ImportCommand}"
                                    Padding="18,9" Margin="0,0,10,0" />
                            <Button Grid.Column="1"
                                    Content="Cancel"
                                    Command="{Binding RepositoryManager.CancelCommand}"
                                    Padding="18,9" Margin="0,0,14,0"
                                    Visibility="{Binding RepositoryManager.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ProgressBar Grid.Column="2"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="True"
                                         Visibility="{Binding RepositoryManager.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <TextBlock Text="{Binding RepositoryManager.StatusMessage}"
                                   Foreground="#CBD5E1" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RepositoryManager.RepositoryPath, StringFormat=Repository: {0}}"
                                   Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RepositoryManager.LastBackupPath, StringFormat=Backup preserved: {0}}"
                                   Foreground="#64748B" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                        <Border Margin="0,14,0,0" Padding="10" Background="#0B1220" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1">
                            <ListBox ItemsSource="{Binding RepositoryManager.Activity}"
                                     MaxHeight="150"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#94A3B8"
                                     FontFamily="Consolas"
                                     FontSize="11" />
                        </Border>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="4" Margin="0,0,0,22">
                    <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Git" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Flutter" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Java" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Android SDK" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Padding="22" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Getting started" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="1. Import a Git repository and select a branch.   2. Run Environment Doctor.   3. Resolve blockers.   4. Build or run on a device." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <TextBlock Text="{Binding RepositoryManager.StatusMessage}" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Flutter Build Doctor • Foundation" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
