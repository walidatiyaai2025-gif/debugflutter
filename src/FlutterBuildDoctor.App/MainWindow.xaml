<Window x:Class="FlutterBuildDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flutter Build Doctor"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Flutter Build Doctor" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="4,8,4,26" />
                    <TextBlock Text="HOME" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,0,0,8" />
                    <Button Content="Dashboard" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Projects" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <TextBlock Text="TOOLCHAIN" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,18,0,8" />
                    <Button Content="Environment Doctor" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Compatibility" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Build Center" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Devices &amp; Emulators" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <TextBlock Text="RECOVERY" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,18,0,8" />
                    <Button Content="Problems" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Auto Repair" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Release Center" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="No project selected" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Import a Flutter repository to begin diagnostics" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Import Project" Padding="18,9" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <TextBlock Text="System readiness" Foreground="#F8FAFC" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Validate Git, Flutter, Java and Android before your first build." Foreground="#94A3B8" FontSize="14" Margin="0,6,0,24" />

                <UniformGrid Columns="4" Margin="0,0,0,22">
                    <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Git" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Flutter" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Java" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel><TextBlock Text="Android SDK" Foreground="#94A3B8"/><TextBlock Text="Not scanned" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Padding="22" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Getting started" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="1. Import a Git repository and select a branch.   2. Run Environment Doctor.   3. Resolve blockers.   4. Build or run on a device." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <TextBlock Text="Ready" Foreground="#94A3B8" VerticalAlignment="Center" />
                <TextBlock Text="Flutter Build Doctor • Foundation" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>