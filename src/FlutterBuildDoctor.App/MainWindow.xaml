<Window x:Class="FlutterBuildDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flutter Build Doctor"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Flutter Build Doctor" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="4,8,4,26" />
                    <TextBlock Text="HOME" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,0,0,8" />
                    <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Projects" Command="{Binding ShowProjectsCommand}" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <TextBlock Text="TOOLCHAIN" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,18,0,8" />
                    <Button Content="Environment Doctor" Command="{Binding ShowEnvironmentDoctorCommand}" Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Compatibility" IsEnabled="False" ToolTip="Compatibility backend is not ready yet." Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Build Center" IsEnabled="False" ToolTip="Build command backend is not ready yet." Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Devices &amp; Emulators" IsEnabled="False" ToolTip="Device and emulator backend is not ready yet." Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <TextBlock Text="RECOVERY" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,18,0,8" />
                    <Button Content="Problems" IsEnabled="False" ToolTip="Problem analysis backend is not ready yet." Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Auto Repair" IsEnabled="False" ToolTip="Repair plans are not ready yet." Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                    <Button Content="Release Center" IsEnabled="False" ToolTip="Release workflow backend is not ready yet." Height="40" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,0,0,6" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid ToolTip="{Binding ProjectHeader.RepositoryPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,4,18,4">
                    <TextBlock Text="{Binding ProjectHeader.ProjectName}" Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ProjectHeader.BranchText}" Foreground="#CBD5E1" FontSize="11" />
                        <TextBlock Text="  •  " Foreground="#475569" FontSize="11" />
                        <TextBlock Text="{Binding ProjectHeader.CommitText}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProjectHeader.RemoteText}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Import Project"
                        Command="{Binding ShowProjectsCommand}"
                        Padding="18,9"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="28">
                    <TextBlock Text="System readiness" Foreground="#F8FAFC" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Use the live detectors that are already implemented, then continue to project import and later build workflows." Foreground="#94A3B8" FontSize="14" Margin="0,6,0,24" />

                    <UniformGrid Columns="4" Margin="0,0,0,22">
                        <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Git" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding EnvironmentDoctor.GitSummary}" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Flutter" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding EnvironmentDoctor.FlutterSummary}" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Java" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding EnvironmentDoctor.JavaSummary}" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Padding="18" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Android SDK" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding EnvironmentDoctor.AndroidSdkSummary}" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Padding="22" Margin="0,0,0,22" Background="#111C2F" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ready actions" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Only working backend capabilities are enabled. Planned screens remain disabled until their services are implemented and validated." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,8,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Run Environment Doctor" Command="{Binding ShowEnvironmentDoctorCommand}" Padding="18,9" Margin="0,0,10,0" />
                                <Button Content="Open Projects" Command="{Binding ShowProjectsCommand}" Padding="18,9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="22" Background="#111C2F" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Getting started" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="1. Run Environment Doctor.   2. Import or refresh a Git repository.   3. Resolve detected toolchain blockers.   4. Build features will unlock when their backend tasks are complete." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsProjectsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="28">
                    <TextBlock Text="Projects" Foreground="#F8FAFC" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Clone a repository or safely refresh an existing workspace, then switch to the requested branch." Foreground="#94A3B8" FontSize="14" Margin="0,6,0,24" />

                    <Border Padding="22" Background="#111C2F" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Repository Manager" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="The refresh workflow preserves backup/rollback safety and recovers from Windows file locks." Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding RepositoryManager.GitStatus}"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Git URL" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,12" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding RepositoryManager.RepositoryUrl, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding RepositoryManager.CanEdit}"
                                         Padding="10,8" Margin="0,0,0,12"
                                         Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Branch" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,12" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding RepositoryManager.Branch, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding RepositoryManager.CanEdit}"
                                         Padding="10,8" Margin="0,0,0,12"
                                         Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding RepositoryManager.WorkspaceDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding RepositoryManager.CanEdit}"
                                         Padding="10,8"
                                         Background="#0B1220" Foreground="#F8FAFC" BorderBrush="#334155" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Import / Refresh"
                                        Command="{Binding RepositoryManager.ImportCommand}"
                                        Padding="18,9" Margin="0,0,10,0" />
                                <Button Grid.Column="1"
                                        Content="Cancel"
                                        Command="{Binding RepositoryManager.CancelCommand}"
                                        Padding="18,9" Margin="0,0,14,0"
                                        Visibility="{Binding RepositoryManager.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ProgressBar Grid.Column="2"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True"
                                             Visibility="{Binding RepositoryManager.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <TextBlock Text="{Binding RepositoryManager.StatusMessage}"
                                       Foreground="#CBD5E1" Margin="0,16,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RepositoryManager.RepositoryPath, StringFormat=Repository: {0}}"
                                       Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RepositoryManager.LastBackupPath, StringFormat=Backup preserved: {0}}"
                                       Foreground="#64748B" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                            <Border Margin="0,14,0,0" Padding="10" Background="#0B1220" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1">
                                <ListBox ItemsSource="{Binding RepositoryManager.Activity}"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#94A3B8"
                                         FontFamily="Consolas"
                                         FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEnvironmentDoctorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="28">
                    <TextBlock Text="Environment Doctor" Foreground="#F8FAFC" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="Runs the real Git, Flutter, Java and Android SDK detectors already implemented by the runtime layer." Foreground="#94A3B8" FontSize="14" Margin="0,6,0,20" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Run / Refresh Scan" Command="{Binding EnvironmentDoctor.ScanCommand}" Padding="18,9" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding EnvironmentDoctor.CancelCommand}" Padding="18,9" Margin="0,0,14,0"
                                Visibility="{Binding EnvironmentDoctor.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ProgressBar Grid.Column="2" Height="8" VerticalAlignment="Center" IsIndeterminate="True"
                                     Visibility="{Binding EnvironmentDoctor.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <TextBlock Text="{Binding EnvironmentDoctor.StatusMessage}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding EnvironmentDoctor.LastScannedAt, StringFormat=Last scan: {0:G}}" Foreground="#64748B" FontSize="11" Margin="0,0,0,18" />

                    <UniformGrid Columns="2">
                        <Border Margin="0,0,10,10" Padding="20" Background="#111C2F" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Git" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding EnvironmentDoctor.GitSummary}" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,6" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EnvironmentDoctor.GitDetails}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,10" Padding="20" Background="#111C2F" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Flutter SDK" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding EnvironmentDoctor.FlutterSummary}" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,6" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EnvironmentDoctor.FlutterDetails}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,10,0" Padding="20" Background="#111C2F" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Java / JDK" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding EnvironmentDoctor.JavaSummary}" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,6" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EnvironmentDoctor.JavaDetails}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Padding="20" Background="#111C2F" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Android SDK" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding EnvironmentDoctor.AndroidSdkSummary}" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,6" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EnvironmentDoctor.AndroidSdkDetails}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Flutter Build Doctor • main-ready shell" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
